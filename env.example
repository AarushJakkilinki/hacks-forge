# StudyParadise Environment Variables

# API Key for Claude (only needed if using a backend API proxy)
# Leave blank if judges will use Claude.ai artifact or allow browser-level Claude access
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Custom API endpoint (if self-hosting a proxy)
# CLAUDE_API_URL=https://your-api.vercel.app/api/claude

# Optional: Model tier (for advanced deployments)
# CLAUDE_MODEL=claude-opus-4-6
